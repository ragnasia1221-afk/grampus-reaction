<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>【反応まとめ】{{ home_team }} {{ home_score }}-{{ away_score }} {{ away_team }}</title>
<style>
  :root{
    --paper:#f6f2ea;
    --paper-2:#efe9dc;
    --ink:#241f19;
    --ink-soft:#6b6153;
    --nagoya:#8c1d20;
    --nagoya-deep:#5c1214;
    --nagoya-gold:#c8a24a;
    --shimizu:#e8781f;
    --shimizu-deep:#b95612;
    --line:#ddd3bf;
    --other:#4a5a63;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:"Meiryo UI","Meiryo","メイリオ","Hiragino Kaku Gothic ProN","Yu Gothic UI",sans-serif;
    line-height:1.85;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:760px;margin:0 auto;padding:0 20px 80px;}

  /* header / scoreboard */
  .masthead{
    padding:38px 20px 0;
    text-align:center;
  }
  .eyebrow{
    font-size:12px;
    letter-spacing:.24em;
    color:var(--ink-soft);
    font-weight:700;
  }
  .wrap > .masthead h1{
    font-size:26px;
    font-weight:700;
    margin:10px 0 26px;
    line-height:1.6;
  }

  .scoreboard{
    background:linear-gradient(180deg,#2a2019,#1b140f);
    border-radius:6px;
    padding:26px 18px 22px;
    color:#f3ead9;
    box-shadow:0 10px 30px -14px rgba(0,0,0,.5);
  }
  .score-meta{
    font-size:11px;
    letter-spacing:.14em;
    color:#c9bda3;
    margin-bottom:16px;
  }
  .score-row{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:18px;
  }
  .club{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:8px;
    width:120px;
  }
  .badge{
    width:52px;height:52px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-size:22px;font-weight:700;color:#fff;
    box-shadow:inset 0 0 0 2px rgba(255,255,255,.25);
    flex-shrink:0;
  }
  .badge.nagoya{background:radial-gradient(circle at 32% 28%,#a6272a,var(--nagoya-deep));}
  .badge.shimizu{background:radial-gradient(circle at 32% 28%,#f3934a,var(--shimizu-deep));}
  .badge.mini{width:30px;height:30px;font-size:13px;}
  .club-name{font-size:13px;font-weight:700;letter-spacing:.04em;}
  .score-num{
    font-size:44px;font-weight:700;
    display:flex;align-items:center;gap:14px;
  }
  .score-dash{color:#8f8471;font-size:28px;}
  .score-goal{font-size:11px;color:#c9bda3;margin-top:2px;}

  /* summary card */
  .summary{
    margin-top:26px;
    background:var(--paper-2);
    border:1px solid var(--line);
    border-radius:4px;
    padding:24px 22px;
    font-size:15px;
  }
  .summary h2{
    font-size:15px;
    margin:0 0 12px;
    display:flex;
    align-items:center;
    gap:8px;
  }
  .summary h2::before{
    content:"";
    width:14px;height:14px;
    background:var(--nagoya);
    display:inline-block;
    transform:rotate(45deg);
  }
  .summary p{margin:0 0 10px;color:#3b352c;}
  .summary p:last-child{margin-bottom:0;}
  .summary .cite{font-size:12px;color:var(--ink-soft);margin-top:14px;}

  /* section headers */
  .section{margin-top:48px;}
  .section-head{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:18px;
  }
  .section-head .rule{flex:1;height:1px;background:var(--line);}
  .section-title{
    font-size:19px;
    font-weight:700;
    white-space:nowrap;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .section-sub{font-size:12px;color:var(--ink-soft);margin:-10px 0 20px;}

  /* comment cards */
  .comment{
    display:flex;
    gap:12px;
    padding:16px 0;
    border-bottom:1px solid var(--line);
  }
  .comment:last-child{border-bottom:none;}
  .comment .who{
    flex-shrink:0;
    width:64px;
    text-align:center;
  }
  .comment .who .tag{
    display:block;
    font-size:10px;
    color:var(--ink-soft);
    margin-top:4px;
    letter-spacing:.02em;
  }
  .comment .body{flex:1;min-width:0;}
  .comment .meta{
    font-size:11px;
    color:var(--ink-soft);
    margin-bottom:6px;
    display:flex;
    gap:8px;
    align-items:center;
  }
  .comment .paraphrase{
    font-size:14.5px;
    color:#3b352c;
    margin-bottom:6px;
  }
  .comment .quote{
    font-size:15.5px;
    color:var(--ink);
  }
  .comment .quote span.line{
    display:inline;
  }
  .comment .quote span.line::before{content:"「";color:var(--ink-soft);}
  .comment .quote span.line::after{content:"」";color:var(--ink-soft);}

  .badge.other{background:linear-gradient(135deg,#6b7c86,var(--other));}
  .badge.nichan{background:linear-gradient(135deg,#6b5b8c,#3f3357);}

  /* X post cards */
  .xpost{
    background:#fff;
    border:1px solid var(--line);
    border-radius:10px;
    padding:14px 16px;
    margin-bottom:12px;
    display:flex;
    gap:12px;
  }
  .xpost .avatar{
    width:36px;height:36px;border-radius:50%;
    background:linear-gradient(135deg,#f3934a,var(--shimizu-deep));
    flex-shrink:0;
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-size:13px;font-weight:700;
  }
  .xpost .handle{font-size:13px;font-weight:700;}
  .xpost .at{font-size:12px;color:var(--ink-soft);font-weight:400;margin-left:4px;}
  .xpost .paraphrase{font-size:13.5px;color:#3b352c;margin-top:4px;}
  .xpost .quote{font-size:14.5px;margin-top:4px;}

  .footnote{
    margin-top:20px;
    background:var(--paper-2);
    border-left:3px solid var(--nagoya-gold);
    padding:14px 16px;
    font-size:12.5px;
    color:var(--ink-soft);
    border-radius:0 4px 4px 0;
  }

  .source-note{
    text-align:center;
    font-size:11px;
    color:var(--ink-soft);
    margin-top:60px;
    letter-spacing:.04em;
  }

  @media (max-width:480px){
    .score-num{font-size:34px;}
    .club{width:92px;}
    .badge{width:44px;height:44px;font-size:18px;}
    .comment{gap:9px;}
    .comment .who{width:52px;}
  }
</style>
</head>
<body>
<div class="wrap">

  <div class="masthead">
    <div class="eyebrow">MATCH REACTION FILE</div>
    <h1>{{ headline | safe }}</h1>
  </div>

  <div class="scoreboard">
    <div class="score-meta">{{ kickoff_display }} KICK OFF ／ {{ section }} ／ {{ stadium }}{% if attendance %} ／ 観衆 {{ "{:,}".format(attendance) }}人{% endif %}</div>
    <div class="score-row">
      <div class="club">
        <div class="badge nagoya">{{ home_badge_letter }}</div>
        <div class="club-name">{{ home_team }}</div>
      </div>
      <div class="score-num">{{ home_score }}<span class="score-dash">−</span>{{ away_score }}</div>
      <div class="club">
        <div class="badge shimizu">{{ away_badge_letter }}</div>
        <div class="club-name">{{ away_team }}</div>
      </div>
    </div>
    <div class="score-goal">{{ score_goal_line }}</div>
  </div>

  <div class="summary">
    <h2>まとめ</h2>
    {% for para in summary_paragraphs %}
    <p>{{ para }}</p>
    {% endfor %}
    <div class="cite">出典：{{ blog_source_name }} コメント欄 ／ 同記事引用のX投稿{% if nichan_picks %} ／ 5ch実況スレッド{% endif %}</div>
  </div>

  {% if home_comments %}
  <div class="section">
    <div class="section-head">
      <div class="section-title"><span class="badge mini nagoya">{{ home_badge_letter }}</span>{{ home_section_title }}</div>
      <div class="rule"></div>
    </div>

    {% for c in home_comments %}
    <div class="comment">
      <div class="who"><div class="badge mini {{ c.badge_class }}">{{ c.badge_letter }}</div><span class="tag">{{ c.tag_label }}</span></div>
      <div class="body">
        <div class="meta">{% if c.number %}コメント{{ c.number }}{% endif %}</div>
        {% if c.quote %}
        <div class="quote"><span class="line">{{ c.quote }}</span></div>
        {% else %}
        {# 引用の逐語検証に失敗した場合のみ、安全側のフォールバックとして要約を表示する #}
        <div class="paraphrase">{{ c.paraphrase }}</div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if away_comments %}
  <div class="section">
    <div class="section-head">
      <div class="section-title"><span class="badge mini shimizu">{{ away_badge_letter }}</span>{{ away_section_title }}</div>
      <div class="rule"></div>
    </div>

    {% for c in away_comments %}
    <div class="comment">
      <div class="who"><div class="badge mini {{ c.badge_class }}">{{ c.badge_letter }}</div><span class="tag">{{ c.tag_label }}</span></div>
      <div class="body">
        <div class="meta">{% if c.number %}コメント{{ c.number }}{% endif %}</div>
        {% if c.quote %}
        <div class="quote"><span class="line">{{ c.quote }}</span></div>
        {% else %}
        {# 引用の逐語検証に失敗した場合のみ、安全側のフォールバックとして要約を表示する #}
        <div class="paraphrase">{{ c.paraphrase }}</div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if nichan_picks %}
  <div class="section">
    <div class="section-head">
      <div class="section-title"><span class="badge mini nichan">実</span>5ch実況スレッドの反応</div>
      <div class="rule"></div>
    </div>
    {% if nichan_thread_title %}<div class="section-sub">スレッド:「{{ nichan_thread_title }}」より</div>{% endif %}

    {% for n in nichan_picks %}
    <div class="comment">
      <div class="who"><div class="badge mini nichan">実</div><span class="tag">5ch</span></div>
      <div class="body">
        <div class="meta">#{{ n.post_number }}</div>
        {% if n.quote %}
        <div class="quote"><span class="line">{{ n.quote }}</span></div>
        {% else %}
        <div class="paraphrase">{{ n.paraphrase }}</div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if tweets %}
  <div class="section">
    <div class="section-head">
      <div class="section-title">試合後：Xの反応</div>
      <div class="rule"></div>
    </div>

    {% for t in tweets %}
    <div class="xpost">
      <div class="avatar">{{ t.avatar_letter }}</div>
      <div class="body">
        <div><span class="handle">{{ t.author_name }}</span><span class="at">@{{ t.handle }}</span></div>
        <div class="paraphrase">{{ t.paraphrase }}</div>
        {% if t.quote %}<div class="quote"><span class="line">{{ t.quote }}</span></div>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="source-note">
    出典：{{ blog_source_name }} コメント欄 ／ 同記事引用のX投稿{% if nichan_picks %} ／ 5ch実況スレッド「{{ nichan_thread_title }}」{% endif %}<br>
    試合結果出典：Ｊリーグ公式サイト<br>
    このページはスクレイピング結果をもとにClaude APIが自動生成したものです。要約・引用は著作権ルール(逐語引用は15語程度・1ソース1回まで)に沿って生成していますが、公開前の確認を推奨します。
  </div>

</div>
</body>
</html>
